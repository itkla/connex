{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "connex-landing",
  "main": "./custom-worker.ts",
  "compatibility_date": "2026-09-01",
  // OpenNext runs Next.js on the Node.js runtime rather than the edge runtime.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SIGNUP_LIMITER",
        "class_name": "SignupLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SignupLimiter"]
    }
  ]
}
