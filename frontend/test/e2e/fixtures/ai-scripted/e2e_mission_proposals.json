{
  "id": "e2e_mission_proposals",
  "selector": "connex_script_browser_mission_proposals",
  "capabilityClass": "scripted-native",
  "steps": [
    { "afterToolCalls": 0, "protocol": "native", "emit": { "kind": "tool_call", "toolName": "get_record", "arguments": "{\"handle\":\"r1\"}" } },
    { "afterToolCalls": 1, "protocol": "native", "emit": { "kind": "tool_call", "toolName": "find_tools", "arguments": "{\"toolset\":\"write_fields\"}" } },
    { "afterToolCalls": 2, "protocol": "native", "emit": { "kind": "tool_call", "toolName": "update_record_fields", "arguments": "{\"handle\":\"r1\",\"title\":\"Head of Partnerships\"}" } },
    { "afterToolCalls": 3, "protocol": "native", "emit": { "kind": "tool_call", "toolName": "find_tools", "arguments": "{\"toolset\":\"write_followup\"}" } },
    { "afterToolCalls": 4, "protocol": "native", "emit": { "kind": "tool_call", "toolName": "set_response_due", "arguments": "{\"handle\":\"r1\",\"due_in_hours\":24}" } },
    { "afterToolCalls": 5, "protocol": "native", "emit": { "kind": "final", "text": "{\"text\":\"I reviewed [the contact](record:r1) and prepared changes for your review.\",\"citations\":[\"r1\"],\"suggestions\":[],\"title\":null}" } }
  ]
}
