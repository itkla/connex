ORG_NAME=CONNEX

# Runtime server configuration. Use product to restore account-signup CTAs.
CONNEX_LANDING_MODE=prelaunch
# Hostnames that must serve the prelaunch page whatever CONNEX_LANDING_MODE says, comma separated.
# A leading dot is a suffix match. Lets one deployment serve the launched page on a preview host
# while the public apex still collects signups.
CONNEX_LANDING_PRELAUNCH_HOSTS=
# A Resend API key with Contacts access, and a dedicated Connex launch Segment.
# These are server-only; never prefix them with NEXT_PUBLIC_.
RESEND_API_KEY=
RESEND_LAUNCH_SEGMENT_ID=
