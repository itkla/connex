# Connex — EVAL profile (local trial only; NOT for production).
# Copy to deploy/.env for a zero-config local run against the bundled MySQL.
# SPRING_PROFILES_ACTIVE=dev relaxes the fail-closed security posture (plaintext DB, local
# secret defaults, non-secure cookies) so the stack boots without TLS or generated secrets.
# A deployment profile is still set so profile behaviour can be exercised.

CONNEX_VERSION=dev
SPRING_PROFILES_ACTIVE=dev
CONNEX_DEPLOYMENT_PROFILE=silo
CONNEX_HTTP_PORT=8088

CONNEX_DB_NAME=connexdb
CONNEX_DB_USERNAME=connexuser
CONNEX_DB_PASSWORD=evalpassword
CONNEX_DB_ROOT_PASSWORD=evalrootpassword
CONNEX_DB_URL=jdbc:mysql://db:3306/connexdb?createDatabaseIfNotExist=true&sslMode=DISABLED&allowPublicKeyRetrieval=true

CONNEX_OBJECT_STORAGE_PROVIDER=filesystem
CONNEX_OBJECT_STORAGE_FILESYSTEM_ROOT=/var/lib/connex/objects

CONNEX_MAIL_ENABLED=false
