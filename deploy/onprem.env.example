# Connex — ON-PREM profile (customer-operated, single-tenant).
# Copy to deploy/.env, fill every REPLACE_* value, and keep it out of version control.
# The customer holds all secrets and key custody; Connex has no data-plane access.

CONNEX_VERSION=REPLACE_WITH_RELEASE_TAG
CONNEX_BACKEND_DIGEST=
CONNEX_FRONTEND_DIGEST=
CONNEX_OCR_DIGEST=
CONNEX_CLAMAV_DIGEST=
COMPOSE_PROFILES=ocr,clamav
CONNEX_DEPLOYMENT_PROFILE=on-prem
CONNEX_HTTP_PORT=80
CONNEX_CADDY_HSTS_ENABLED=false

# The full frontend CSP starts in Report-Only. Promote to "enforce" only after the staging
# browser-console procedure in docs/CONTENT_SECURITY_POLICY.md is clean; restore "report-only"
# and recreate the frontend service to roll back. Optional image origins are exact HTTPS origins.
CONNEX_CSP_MODE=report-only
CONNEX_CSP_IMAGE_ORIGINS=
# Leave empty for direct clients. Add only exact peers that overwrite inbound CF-Connecting-IP and
# X-Forwarded-For with an authenticated client IP, and restrict the listener to those peers.
CONNEX_CADDY_ADDITIONAL_TRUSTED_PROXIES=
# Docker DNS limits forwarded-header trust to Caddy and the frontend without fixed bridge addresses.
CONNEX_SECURITY_TRUSTED_PROXIES=caddy,frontend

# Public origin the bundle is served on.
CONNEX_MAIL_APP_BASE_URL=https://REPLACE.internal.example.com
CONNEX_CORS_ALLOWED_ORIGINS=https://REPLACE.internal.example.com
CONNEX_WEBAUTHN_ALLOWED_ORIGINS=https://REPLACE.internal.example.com
CONNEX_WEBAUTHN_RP_ID=REPLACE.internal.example.com

# Database. On-prem operators typically point at their own managed database rather than the
# bundled MySQL; either way non-dev requires verified TLS (sslMode=VERIFY_CA/VERIFY_IDENTITY).
CONNEX_DB_NAME=connexdb
CONNEX_DB_USERNAME=connexuser
CONNEX_DB_PASSWORD=REPLACE_STRONG_PASSWORD
CONNEX_DB_ROOT_PASSWORD=REPLACE_STRONG_ROOT_PASSWORD
CONNEX_DB_URL=jdbc:mysql://db:3306/connexdb?sslMode=VERIFY_CA

# Private uploads. The bundled filesystem provider is backed by the object_data volume.
# See docs/DEPLOYMENT.md for S3-compatible storage configuration.
CONNEX_OBJECT_STORAGE_PROVIDER=filesystem
CONNEX_OBJECT_STORAGE_FILESYSTEM_ROOT=/var/lib/connex/objects
CONNEX_OBJECT_STORAGE_FILESYSTEM_MIN_FREE_BYTES=1073741824
CONNEX_OBJECT_STORAGE_FILESYSTEM_TEMP_RETENTION=1h
CONNEX_OBJECT_STORAGE_FILESYSTEM_TEMP_CLEANUP_DELAY_MS=60000
CONNEX_OBJECT_STORAGE_AMBIGUOUS_WRITE_CLEANUP_DELAY_MS=60000
CONNEX_OBJECT_STORAGE_MAX_CONCURRENT_READS=32
CONNEX_OBJECT_STORAGE_MAX_CONCURRENT_READS_PER_USER=4
CONNEX_OBJECT_STORAGE_READ_TIMEOUT_MS=30000

# Secrets — generated and held by the customer (never leaves the customer environment).
CONNEX_SECRET_STORE_MASTER_KEY=REPLACE_BASE64_32_BYTE_KEY
CONNEX_AUDIT_INTEGRITY_HMAC_SECRET=REPLACE_AT_LEAST_32_CHARS

# Privileged MFA defaults on. See docs/PRIVILEGED_MFA.md for staged rollout and recovery.
CONNEX_PRIVILEGED_MFA_ENFORCED=true
CONNEX_PRIVILEGED_MFA_CHANGE_ACTOR=configuration-default
CONNEX_PRIVILEGED_MFA_RECOVERY_TOKEN_SHA256=
CONNEX_PRIVILEGED_MFA_RECOVERY_EXPIRES_AT=
CONNEX_PRIVILEGED_MFA_RECOVERY_ACTOR=
CONNEX_BREACHED_PASSWORD_SOURCE=REMOTE
# For restricted egress, select OFFLINE and mount the verified corpus as documented in
# docs/BREACHED_PASSWORD_SCREENING.md.
CONNEX_BREACHED_PASSWORD_OFFLINE_FILE=
CONNEX_BREACHED_PASSWORD_OFFLINE_SHA256=

# Metrics scraping. GET /api/metrics is gated on this token alone — an ordinary authenticated
# session cannot read it. Blank (the default) keeps the endpoint unavailable to every caller
# and is warned about at startup. Set a long random value and send it as
# "Authorization: Bearer <token>" from your scraper.
CONNEX_METRICS_SCRAPE_TOKEN=

# First-run bootstrap of the initial owner (on-prem only; set false after the first login exists).
CONNEX_BOOTSTRAP_ENABLED=false

# Workspace creation is invite-only by default: registration does not auto-provision a
# workspace and the create endpoint is refused. Set true to let users create their own.
CONNEX_WORKSPACES_ALLOW_CREATION=false

# Business-card OCR is enabled by default. See docs/DEPLOYMENT.md for the low-resource opt-out.
CONNEX_BUSINESS_CARD_SCANNING_ENABLED=true
CONNEX_BUSINESS_CARD_IMAGE_MAX_BYTES=8388608
CONNEX_BUSINESS_CARD_IMAGE_MAX_WIDTH=8192
CONNEX_BUSINESS_CARD_IMAGE_MAX_HEIGHT=8192
CONNEX_BUSINESS_CARD_IMAGE_MAX_PIXELS=24000000
CONNEX_BUSINESS_CARD_MAX_SCANS_PER_MINUTE=3
CONNEX_BUSINESS_CARD_MAX_GLOBAL_SCANS_PER_MINUTE=5
CONNEX_BUSINESS_CARD_MAX_IMPORTS_PER_MINUTE=12
CONNEX_BUSINESS_CARD_IDEMPOTENCY_RETENTION=24h
CONNEX_BUSINESS_CARD_RESERVATION_LEASE=2m
CONNEX_BUSINESS_CARD_MAX_OUTSTANDING_RESERVATIONS=4
CONNEX_BUSINESS_CARD_IDEMPOTENCY_CLEANUP_DELAY=1m
CONNEX_BUSINESS_CARD_IDEMPOTENCY_CLEANUP_PER_WORKSPACE_BATCH_SIZE=100
CONNEX_OCR_BASE_URL=http://ocr:8090
CONNEX_OCR_PLAIN_HTTP_PRIVATE_HOST=ocr
CONNEX_OCR_SERVICE_TOKEN=REPLACE_AT_LEAST_32_CHARS
CONNEX_OCR_REQUEST_TIMEOUT=15s
CONNEX_OCR_REQUEST_TIMEOUT_SECONDS=12
CONNEX_OCR_STARTUP_TIMEOUT_SECONDS=180
CONNEX_OCR_MAX_REQUEST_HANDLERS=8

# Malware scanning (CHK-062). This is a mandatory CONTROL, not an optional feature: the backend
# refuses to start in a deployment profile unless it is enabled and configured, and if the sidecar
# is unreachable every upload fails closed with 503 rather than being admitted unscanned.
# The sidecar needs ~3 GiB of memory and a 512 MiB scan tmpfs; a host that cannot supply that
# cannot run Connex with attachments enabled. See docs/MALWARE_SCANNING.md.
CONNEX_MALWARE_SCANNING_ENABLED=true
CONNEX_CLAMAV_BASE_URL=http://clamav:8091
CONNEX_CLAMAV_PLAIN_HTTP_PRIVATE_HOST=clamav
CONNEX_CLAMAV_SERVICE_TOKEN=REPLACE_AT_LEAST_32_CHARS
CONNEX_CLAMAV_CONNECT_TIMEOUT=2s
# The backend read timeout must stay strictly ABOVE the sidecar's own scan deadline so the
# sidecar gives up first and returns a classifiable answer.
CONNEX_CLAMAV_REQUEST_TIMEOUT=45s
CONNEX_CLAMAV_SCAN_TIMEOUT_SECONDS=40
CONNEX_CLAMAV_MAX_CONCURRENT_SCANS=2
CONNEX_CLAMAV_STARTUP_TIMEOUT_SECONDS=300
# Signature source. "baked" uses the verified set compiled into the image, which is refreshed by
# pulling a newer image. "volume" reads an operator-managed directory instead and REQUIRES the
# docker-compose.signatures.yml overlay plus CONNEX_CLAMAV_SIGNATURE_DIR; without the overlay the
# sidecar refuses to start rather than quietly falling back to the baked set. Air-gapped sites
# that cannot pull images need "volume" before the baked set reaches the 30-day ceiling.
# Procedure: docs/MALWARE_SCANNING.md.
CONNEX_CLAMAV_SIGNATURE_SOURCE=baked
# COMPOSE_FILE=docker-compose.yml:docker-compose.signatures.yml
# CONNEX_CLAMAV_SIGNATURE_DIR=/srv/connex/clamav-signatures
# Signatures warn at 7 days and HARD-BLOCK uploads at 30. The ceiling cannot be raised: scanning
# against month-old signatures while reporting "protected" is worse than refusing. Watch
# seconds_until_block in /settings/diagnostics and update well before the cliff.
# These come in pairs: the *_SECONDS variables configure the sidecar, the duration-typed ones
# configure the backend's own independent re-check. CHANGE BOTH HALVES TOGETHER or the two will
# disagree about when to start warning and when to start refusing uploads.
CONNEX_CLAMAV_SIGNATURE_WARN_AGE_SECONDS=604800
CONNEX_CLAMAV_SIGNATURE_MAX_AGE_SECONDS=2592000
CONNEX_CLAMAV_SIGNATURE_WARN_AGE=7d
CONNEX_CLAMAV_SIGNATURE_MAX_AGE=30d

# Mail — point at an internal relay if desired. allow-internal-hosts is permitted on-prem.
CONNEX_MAIL_ENABLED=false
CONNEX_SIGNATURE_ENABLED=false
