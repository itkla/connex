# Connex on-prem database backup configuration.
# Copy to /etc/connex-backup/backup.env, keep it mode 0600, and create the
# referenced MySQL defaults files separately with mode 0600.
#
# Full backups and binlogs become prune-eligible at retention minus one day.
# The default 30-day legal cap therefore prunes at 29 days, leaving one full
# timer interval of safety before any artifact could reach 30 days wall-clock.
# The server's own binlog_expire_logs_seconds must be <= (retention - 1) days
# (<= 29d at the default) or the archive run refuses to proceed, so server-side
# copies never outlive the legal ceiling either.
#
# Stream mode is the Compose default. Disabling FLUSH requires the explicit
# acknowledgement below because RPO then becomes unbounded by the archive timer
# and the operator is responsible for binary-log rotation.
#
# RESTORE_VERIFY defaults to true: every full run restores each dump into a
# throwaway scratch schema and compares table counts, so a gzip-valid but
# semantically incomplete dump cannot be published as COMPLETE. Point the
# verify profile at a non-production host if the added load matters.

CONNEX_BACKUP_ROOT=/var/backups/connex
CONNEX_BACKUP_RETENTION_DAYS=30
CONNEX_BACKUP_MIN_FREE_BYTES=5368709120
CONNEX_BACKUP_FAILED_GRACE_HOURS=24
CONNEX_BACKUP_GZIP_LEVEL=6
CONNEX_BACKUP_LOCK_DIR=/run/connex-backup

CONNEX_BACKUP_DB_HOST=localhost
CONNEX_BACKUP_DB_PORT=3306
CONNEX_BACKUP_DB_USER=root
CONNEX_BACKUP_SOURCE_DEFAULTS_FILE=/etc/connex-backup/source.cnf

CONNEX_BACKUP_SCHEMA_INCLUDE=
CONNEX_BACKUP_SCHEMA_EXCLUDE=information_schema,performance_schema,mysql,sys

CONNEX_BACKUP_BINLOG_FETCH_MODE=stream
CONNEX_BACKUP_BINLOG_FLUSH=true
CONNEX_BACKUP_BINLOG_NO_FLUSH_ACK=false
CONNEX_BACKUP_BINLOG_DIR=/var/lib/mysql
CONNEX_BACKUP_BINLOG_STREAM="docker exec -i connex-db-1 cat"
CONNEX_BACKUP_BINLOG_STAT="docker exec -i connex-db-1 stat -c %W:%Y"

CONNEX_BACKUP_RESTORE_VERIFY=true
CONNEX_BACKUP_VERIFY_DB_HOST=localhost
CONNEX_BACKUP_VERIFY_DB_PORT=3306
CONNEX_BACKUP_VERIFY_DB_USER=root
CONNEX_BACKUP_VERIFY_DEFAULTS_FILE=/etc/connex-backup/verify.cnf

CONNEX_BACKUP_RESTORE_DB_HOST=localhost
CONNEX_BACKUP_RESTORE_DB_PORT=3306
CONNEX_BACKUP_RESTORE_DB_USER=root
CONNEX_BACKUP_RESTORE_DEFAULTS_FILE=/etc/connex-backup/restore.cnf
# Protected schemas can only be overwritten by a restore with --force-overwrite.
# List every production schema name here; the pattern is matched case-insensitively
# and also guards any existing non-empty target regardless of name.
CONNEX_BACKUP_PROTECTED_SCHEMAS=connex_pub,connexdb
CONNEX_BACKUP_PROTECTED_SCHEMA_PATTERN="^connexdb$|^connex_pub$|prod"

MYSQL=/usr/local/lib/connex-backup/shims/mysql
MYSQLDUMP=/usr/local/lib/connex-backup/shims/mysqldump
MYSQLBINLOG=/usr/local/lib/connex-backup/shims/mysqlbinlog

CONNEX_BACKUP_DB_CONTAINER=connex-db-1
CONNEX_BACKUP_DOCKER_CLIENT_MODE=exec
CONNEX_BACKUP_DOCKER_BIN=docker
CONNEX_BACKUP_DOCKER_NETWORK=connex_default
CONNEX_BACKUP_DOCKER_IMAGE=mysql:8.4.10@sha256:c831a0f11348d402b43d77453e17d770be2eef356615a2823fe0f5a0d6c8b9af
CONNEX_BACKUP_DOCKER_BINLOG_IMAGE=percona/percona-server:8.4
CONNEX_BACKUP_DEFAULTS_DIR=/etc/connex-backup
CONNEX_BACKUP_DOCKER_MOUNTS=

CONNEX_BACKUP_FULL_CALENDAR="*-*-* 03:30:00 Asia/Tokyo"
CONNEX_BACKUP_BINLOG_CALENDAR="*:0/15"
CONNEX_BACKUP_PRUNE_CALENDAR="*-*-* 04,16:30:00 Asia/Tokyo"
