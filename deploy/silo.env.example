# Connex — SILO profile (Connex-operated, single-tenant).
# Copy to deploy/.env, fill every REPLACE_* value, and keep it out of version control.
# Runs the non-dev, fail-closed security posture: secrets and verified DB TLS are required.

CONNEX_VERSION=REPLACE_WITH_RELEASE_TAG
CONNEX_DEPLOYMENT_PROFILE=silo
CONNEX_HTTP_PORT=80

# Public origin the bundle is served on (single origin — Caddy fronts frontend + backend).
CONNEX_MAIL_APP_BASE_URL=https://REPLACE.example.com
CONNEX_CORS_ALLOWED_ORIGINS=https://REPLACE.example.com
CONNEX_WEBAUTHN_ALLOWED_ORIGINS=https://REPLACE.example.com
CONNEX_WEBAUTHN_RP_ID=REPLACE.example.com

# Database. The bundled MySQL is the default host (service name "db"). Non-dev requires a
# verified TLS transport (sslMode=VERIFY_CA or VERIFY_IDENTITY) — either configure TLS on the
# bundled MySQL and trust its CA, or point CONNEX_DB_URL at a managed TLS database.
CONNEX_DB_NAME=connexdb
CONNEX_DB_USERNAME=connexuser
CONNEX_DB_PASSWORD=REPLACE_STRONG_PASSWORD
CONNEX_DB_ROOT_PASSWORD=REPLACE_STRONG_ROOT_PASSWORD
CONNEX_DB_URL=jdbc:mysql://db:3306/connexdb?sslMode=VERIFY_IDENTITY

# Secrets — generate strong, unique values (never commit). See docs/DEPLOYMENT.md.
CONNEX_SECRET_STORE_MASTER_KEY=REPLACE_BASE64_32_BYTE_KEY
CONNEX_AUDIT_INTEGRITY_HMAC_SECRET=REPLACE_AT_LEAST_32_CHARS

# Mail — instance transport is authoritative for silo (managed). Configure a relay to enable.
CONNEX_MAIL_ENABLED=false
CONNEX_MAIL_MANAGED=true
