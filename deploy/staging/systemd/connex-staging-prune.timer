[Unit]
Description=Prune the Connex staging release quarantine daily

[Timer]
# Early morning, well away from the five-minute deploy cadence.
OnCalendar=*-*-* 04:20:00
# The host is not always up at 04:20; catch up on the next boot rather than skipping a day.
Persistent=true
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
