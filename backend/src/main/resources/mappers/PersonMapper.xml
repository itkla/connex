<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ooo.klae.connex.backend.mappers.PersonMapper">

  <resultMap id="PersonResult" type="Person">
    <id     property="id"        column="id"/>
    <result property="name"      column="name"/>
    <result property="email"     column="email"/>
    <result property="phone"     column="phone"/>
    <result property="title"     column="title"/>
    <result property="createdAt" column="created_at"/>
    <result property="updatedAt" column="updated_at"/>
    <result property="imageUrl" column="image_url"/>
    <association property="company" javaType="Company" notNullColumn="company_id">
      <id property="id" column="company_id"/>
      <result property="name" column="company_name"/>
      <result property="logoUrl" column="company_logo_url"/>
    </association>
  </resultMap>

  <resultMap id="PersonFullResult" type="Person" extends="PersonResult">
    <collection property="deals" ofType="Deal" column="id" select="ooo.klae.connex.backend.mappers.DealMapper.getDealsByPersonId"/>
    <collection property="activities" ofType="Activity" column="id" select="ooo.klae.connex.backend.mappers.ActivityMapper.getActivitiesByPersonId"/>
    <collection property="notes" ofType="Note" column="id" select="ooo.klae.connex.backend.mappers.NoteMapper.getNotesByPersonId"/>
    <collection property="tasks" ofType="Task" column="id" select="ooo.klae.connex.backend.mappers.TaskMapper.getTasksByPersonId"/>
    <collection property="tags" ofType="Tag" column="id" select="ooo.klae.connex.backend.mappers.TagMapper.getTagsByPersonId"/>
  </resultMap>

  <sql id="personColumns">
    p.id, p.name, p.email, p.phone, p.company_id, p.title, p.created_at, p.updated_at, p.image_url
  </sql>

  <sql id="companyJoinColumns">
    c.name AS company_name, c.logo_url AS company_logo_url
  </sql>

  <sql id="companyJoin">
    LEFT JOIN company c ON c.id = p.company_id
  </sql>

  <select id="getAllPersons" resultMap="PersonResult">
    SELECT <include refid="personColumns"/>, <include refid="companyJoinColumns"/>
    FROM person p
    <include refid="companyJoin"/>
    ORDER BY p.name
  </select>

  <select id="getPersonsByCompanyId" resultMap="PersonFullResult">
    SELECT <include refid="personColumns"/>, <include refid="companyJoinColumns"/>
    FROM person p
    <include refid="companyJoin"/>
    WHERE p.company_id = #{companyId} ORDER BY p.name
  </select>

  <select id="getPersonsByTagId" resultMap="PersonResult">
    SELECT <include refid="personColumns"/>, <include refid="companyJoinColumns"/>
    FROM person p
    <include refid="companyJoin"/>
    JOIN person_tag pt ON pt.person_id = p.id
    WHERE pt.tag_id = #{tagId}
    ORDER BY p.name
  </select>

  <select id="getPersonsByDealId" resultMap="PersonResult">
    SELECT <include refid="personColumns"/>, <include refid="companyJoinColumns"/>
    FROM person p
    <include refid="companyJoin"/>
    JOIN deal_person dp ON dp.person_id = p.id
    WHERE dp.deal_id = #{dealId}
    ORDER BY p.name
  </select>

  <select id="getPersonById" resultMap="PersonFullResult">
    SELECT <include refid="personColumns"/>, <include refid="companyJoinColumns"/>
    FROM person p
    <include refid="companyJoin"/>
    WHERE p.id = #{id}
  </select>

  <insert id="insert" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO person (name, email, phone, company_id, title, image_url)
    VALUES (
      #{name}, #{email}, #{phone},
      <choose>
        <when test="company != null">#{company.id}</when>
        <otherwise>NULL</otherwise>
      </choose>,
      #{title},
      #{imageUrl}
    )
  </insert>

  <update id="update">
    UPDATE person
    <set>
      <if test="name != null">name = #{name},</if>
      <if test="email != null">email = #{email},</if>
      <if test="phone != null">phone = #{phone},</if>
      <if test="title != null">title = #{title},</if>
      company_id = <choose><when test="company != null">#{company.id}</when><otherwise>NULL</otherwise></choose>,
      <if test="imageUrl != null">image_url = #{imageUrl},</if>
    </set>
    WHERE id = #{id}
  </update>

  <delete id="delete">DELETE FROM person WHERE id = #{id}</delete>

  <insert id="addTag">
    INSERT IGNORE INTO person_tag (person_id, tag_id)
    VALUES (#{personId}, #{tagId})
  </insert>

  <delete id="removeTag">
    DELETE FROM person_tag
    WHERE person_id = #{personId} AND tag_id = #{tagId}
  </delete>

  <delete id="clearTags">
    DELETE FROM person_tag WHERE person_id = #{personId}
  </delete>

  <insert id="insertTags">
    INSERT IGNORE INTO person_tag (person_id, tag_id) VALUES
    <foreach collection="tagIds" item="tagId" separator=",">
      (#{personId}, #{tagId})
    </foreach>
  </insert>
</mapper>
