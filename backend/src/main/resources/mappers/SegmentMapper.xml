<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ooo.klae.connex.backend.mappers.SegmentMapper">

    <select id="companyIdsInWorkspace" resultType="int">
        SELECT id FROM company WHERE workspace_id = #{workspaceId}
    </select>

    <select id="personIdsInWorkspace" resultType="int">
        SELECT id FROM person WHERE workspace_id = #{workspaceId}
    </select>

    <select id="dealIdsInWorkspace" resultType="int">
        SELECT id FROM deal WHERE workspace_id = #{workspaceId}
    </select>

    <select id="companyIdsWithOpenDeal" resultType="int">
        SELECT DISTINCT company_id
        FROM deal
        WHERE workspace_id = #{workspaceId}
          AND won IS NULL
          AND company_id IS NOT NULL
    </select>

    <select id="companyIdsNoActivitySince" resultType="int">
        SELECT c.id
        FROM company c
        WHERE c.workspace_id = #{workspaceId}
          AND NOT EXISTS (
              SELECT 1 FROM activity a
              WHERE a.workspace_id = #{workspaceId}
                AND a.timestamp &gt;= DATE_SUB(NOW(), INTERVAL #{days} DAY)
                AND (
                    a.person_id IN (SELECT p.id FROM person p WHERE p.workspace_id = #{workspaceId} AND p.company_id = c.id)
                    OR a.deal_id IN (SELECT d.id FROM deal d WHERE d.workspace_id = #{workspaceId} AND d.company_id = c.id)
                )
          )
    </select>

    <select id="companyIdsForPersonsWithoutUserActivity" resultType="int">
        SELECT DISTINCT p.company_id
        FROM person p
        WHERE p.workspace_id = #{workspaceId}
          AND p.company_id IS NOT NULL
          AND p.id IN
          <foreach item="pid" collection="personIds" open="(" separator="," close=")">#{pid}</foreach>
          AND NOT EXISTS (
              SELECT 1 FROM activity a
              WHERE a.workspace_id = #{workspaceId}
                AND a.created_by_id = #{userId}
                AND (
                    a.person_id IN (SELECT p2.id FROM person p2 WHERE p2.workspace_id = #{workspaceId} AND p2.company_id = p.company_id)
                    OR a.deal_id IN (SELECT d.id FROM deal d WHERE d.workspace_id = #{workspaceId} AND d.company_id = p.company_id)
                )
          )
    </select>

    <sql id="stringOp">
        <choose>
            <when test="op == 'equals'">AND ${col} = #{value}</when>
            <when test="op == 'contains' or op == 'starts_with'">AND ${col} LIKE #{pattern}</when>
            <when test="op == 'is_set'">AND ${col} IS NOT NULL AND ${col} &lt;&gt; ''</when>
            <otherwise>AND 1 = 0</otherwise>
        </choose>
    </sql>

    <sql id="numberOp">
        <choose>
            <when test="op == 'equals'">AND ${col} = #{number}</when>
            <when test="op == 'gt'">AND ${col} &gt; #{number}</when>
            <when test="op == 'gte'">AND ${col} &gt;= #{number}</when>
            <when test="op == 'lt'">AND ${col} &lt; #{number}</when>
            <when test="op == 'lte'">AND ${col} &lt;= #{number}</when>
            <otherwise>AND 1 = 0</otherwise>
        </choose>
    </sql>

    <sql id="idOp">
        <choose>
            <when test="op == 'is'">AND ${col} = #{id}</when>
            <when test="op == 'in'">
                AND ${col} IN
                <foreach item="v" collection="ids" open="(" separator="," close=")">#{v}</foreach>
            </when>
            <otherwise>AND 1 = 0</otherwise>
        </choose>
    </sql>

    <sql id="dateOp">
        <choose>
            <when test="op == 'before'">AND ${col} IS NOT NULL AND ${col} &lt; #{value}</when>
            <when test="op == 'after'">AND ${col} IS NOT NULL AND ${col} &gt; #{value}</when>
            <when test="op == 'within_days'">AND ${col} IS NOT NULL AND ${col} &gt;= #{dateFrom} AND ${col} &lt;= #{dateTo}</when>
            <when test="op == 'is_set'">AND ${col} IS NOT NULL</when>
            <otherwise>AND 1 = 0</otherwise>
        </choose>
    </sql>

    <select id="companyIdsMatching" resultType="int">
        SELECT id FROM company WHERE workspace_id = #{workspaceId}
        <choose>
            <when test="field == 'industry'"><include refid="stringOp"><property name="col" value="industry"/></include></when>
            <when test="field == 'name'"><include refid="stringOp"><property name="col" value="name"/></include></when>
            <when test="field == 'tag'">AND id IN (SELECT company_id FROM company_tag WHERE tag_id = #{id})</when>
            <otherwise>AND 1 = 0</otherwise>
        </choose>
    </select>

    <select id="personIdsMatching" resultType="int">
        SELECT id FROM person WHERE workspace_id = #{workspaceId}
        <choose>
            <when test="field == 'name'"><include refid="stringOp"><property name="col" value="name"/></include></when>
            <when test="field == 'title'"><include refid="stringOp"><property name="col" value="title"/></include></when>
            <when test="field == 'email'"><include refid="stringOp"><property name="col" value="email"/></include></when>
            <when test="field == 'company'"><include refid="idOp"><property name="col" value="company_id"/></include></when>
            <when test="field == 'tag'">AND id IN (SELECT person_id FROM person_tag WHERE tag_id = #{id})</when>
            <otherwise>AND 1 = 0</otherwise>
        </choose>
    </select>

    <select id="dealIdsMatching" resultType="int">
        SELECT id FROM deal WHERE workspace_id = #{workspaceId}
        <choose>
            <when test="field == 'name'"><include refid="stringOp"><property name="col" value="name"/></include></when>
            <when test="field == 'value'"><include refid="numberOp"><property name="col" value="value"/></include></when>
            <when test="field == 'stage'"><include refid="idOp"><property name="col" value="stage_id"/></include></when>
            <when test="field == 'owner'"><include refid="idOp"><property name="col" value="owner_id"/></include></when>
            <when test="field == 'status'">
                <choose>
                    <when test="value == 'won'">AND won = TRUE</when>
                    <when test="value == 'lost'">AND won = FALSE</when>
                    <when test="value == 'open'">AND won IS NULL</when>
                    <otherwise>AND 1 = 0</otherwise>
                </choose>
            </when>
            <when test="field == 'close_date'"><include refid="dateOp"><property name="col" value="expected_close_date"/></include></when>
            <when test="field == 'tag'">AND id IN (SELECT deal_id FROM deal_tag WHERE tag_id = #{id})</when>
            <otherwise>AND 1 = 0</otherwise>
        </choose>
    </select>

    <select id="companyLabels" resultType="ooo.klae.connex.backend.dto.RecordLabelDto">
        SELECT id, name AS label FROM company
        WHERE workspace_id = #{workspaceId}
          AND id IN <foreach item="v" collection="ids" open="(" separator="," close=")">#{v}</foreach>
    </select>

    <select id="personLabels" resultType="ooo.klae.connex.backend.dto.RecordLabelDto">
        SELECT id, name AS label FROM person
        WHERE workspace_id = #{workspaceId}
          AND id IN <foreach item="v" collection="ids" open="(" separator="," close=")">#{v}</foreach>
    </select>

    <select id="dealLabels" resultType="ooo.klae.connex.backend.dto.RecordLabelDto">
        SELECT id, name AS label FROM deal
        WHERE workspace_id = #{workspaceId}
          AND id IN <foreach item="v" collection="ids" open="(" separator="," close=")">#{v}</foreach>
    </select>

    <select id="distinctIndustries" resultType="string">
        SELECT DISTINCT industry FROM company
        WHERE workspace_id = #{workspaceId} AND industry IS NOT NULL AND industry != ''
        ORDER BY industry
    </select>

</mapper>
