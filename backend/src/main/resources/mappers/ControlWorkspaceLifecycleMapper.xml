<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ooo.klae.connex.backend.mappers.ControlWorkspaceLifecycleMapper">

  <select id="countRows" resultType="long" useCache="false">
    SELECT COUNT(*)
    FROM ${declaration.table}
    WHERE ${declaration.workspaceColumn} = #{workspaceId}
  </select>

  <delete id="deleteBatch">
    DELETE FROM ${declaration.table}
    WHERE ${declaration.workspaceColumn} = #{workspaceId}
    LIMIT #{limit}
  </delete>

</mapper>
