<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ooo.klae.connex.backend.mappers.OrganizationMapper">

  <insert id="insert" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO organization (name, slug) VALUES (#{name}, #{slug})
  </insert>

  <select id="getById" resultType="Organization">
    SELECT id, name, slug, created_at, updated_at FROM organization WHERE id = #{id}
  </select>

  <select id="lockById" resultType="java.lang.Integer">
    SELECT id FROM organization WHERE id = #{id} FOR UPDATE
  </select>

  <select id="lockByIdForShare" resultType="java.lang.Integer">
    SELECT id FROM organization WHERE id = #{id} FOR SHARE
  </select>

  <select id="lockActiveByIdForShare" resultType="java.lang.Integer">
    SELECT id
    FROM organization
    WHERE id = #{id} AND lifecycle_state = 'active'
    FOR SHARE
  </select>
</mapper>
