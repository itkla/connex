{
  "id": "create_person_duplicate",
  "selector": "connex_script_create_person_duplicate",
  "capabilityClass": "scripted-native",
  "steps": [
    {
      "afterToolCalls": 0,
      "protocol": "native",
      "emit": {
        "kind": "tool_call",
        "toolName": "search_records",
        "arguments": "{\"query\":\"Alderwick\",\"kinds\":[\"company\"]}"
      }
    },
    {
      "afterToolCalls": 1,
      "protocol": "native",
      "emit": {
        "kind": "tool_call",
        "toolName": "find_tools",
        "arguments": "{\"toolset\":\"write_create\"}"
      }
    },
    {
      "afterToolCalls": 2,
      "protocol": "native",
      "emit": {
        "kind": "tool_call",
        "toolName": "create_person",
        "arguments": "{\"handle\":\"r1\",\"name\":\"Morgan Vale\",\"title\":\"Director\"}"
      }
    },
    {
      "afterToolCalls": 3,
      "protocol": "native",
      "emit": {
        "kind": "final",
        "text": "{\"text\":\"There may already be a contact. Open the create form to review possible matches.\",\"citations\":[],\"suggestions\":[],\"title\":null}"
      }
    }
  ]
}
