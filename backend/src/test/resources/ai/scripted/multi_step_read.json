{
  "id": "multi_step_read",
  "selector": "connex_script_multi_step_read",
  "capabilityClass": "scripted-native",
  "steps": [
    {
      "afterToolCalls": 0,
      "protocol": "native",
      "emit": {
        "kind": "tool_call",
        "toolName": "search_records",
        "arguments": "{\"query\":\"Kestrel\",\"kinds\":[\"person\"]}"
      }
    },
    {
      "afterToolCalls": 1,
      "protocol": "native",
      "emit": {
        "kind": "tool_call",
        "toolName": "get_record",
        "arguments": "{\"handle\":\"r1\"}"
      }
    },
    {
      "afterToolCalls": 2,
      "protocol": "native",
      "emit": {
        "kind": "final",
        "reasoning": "Read the search hit and then the record itself.",
        "text": "{\"text\":\"I checked [the contact](record:r1) and found nothing outstanding.\",\"citations\":[\"r1\"],\"suggestions\":[],\"title\":null}"
      }
    }
  ]
}
