{
  "id": "field_edit_embedded_token",
  "selector": "connex_script_field_edit_embedded_token",
  "capabilityClass": "scripted-native",
  "steps": [
    {
      "afterToolCalls": 0,
      "protocol": "native",
      "emit": {
        "kind": "tool_call",
        "toolName": "find_tools",
        "arguments": "{\"toolset\":\"write_fields\"}"
      }
    },
    {
      "afterToolCalls": 1,
      "protocol": "native",
      "emit": {
        "kind": "tool_call",
        "toolName": "update_record_fields",
        "arguments": "{\"handle\":\"r1\",\"website\":\"target.example/{{C2}}/path\"}"
      }
    },
    {
      "afterToolCalls": 2,
      "protocol": "native",
      "emit": {
        "kind": "final",
        "text": "{\"text\":\"No change was proposed. You can update the record directly.\",\"citations\":[],\"suggestions\":[],\"title\":null}"
      }
    }
  ]
}
