        "arguments": "{\"handle\":\"r1\",\"owner\":\"unassigned\"}"
      }
    },
    {
      "afterToolCalls": 2,
      "protocol": "json",
      "closing": true,
      "emit": {
        "kind": "final",
        "text": "{\"tool\":null,\"final\":{\"text\":\"The proposed change is ready for review.\",\"citations\":[\"r1\"],\"suggestions\":[],\"title\":null}}"
      }
    }
  ]
}
