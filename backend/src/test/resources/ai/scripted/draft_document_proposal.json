{
  "id": "draft_document_proposal",
  "selector": "connex_script_draft_document_proposal",
  "capabilityClass": "scripted-native",
  "steps": [
    {
      "afterToolCalls": 0,
      "protocol": "native",
      "emit": {
        "kind": "tool_call",
        "toolName": "search_records",
        "arguments": "{\"query\":\"Alderwick\",\"kinds\":[\"deal\"]}"
      }
    },
    {
      "afterToolCalls": 1,
      "protocol": "native",
      "emit": {
        "kind": "tool_call",
        "toolName": "find_tools",
        "arguments": "{\"toolset\":\"write_pipeline\"}"
      }
    },
    {
      "afterToolCalls": 2,
      "protocol": "native",
      "emit": {
        "kind": "tool_call",
        "toolName": "draft_document",
        "arguments": "{\"handle\":\"r1\",\"template\":\"Quote\"}"
      }
    },
    {
      "afterToolCalls": 3,
      "protocol": "native",
      "emit": {
        "kind": "final",
        "text": "{\"text\":\"I proposed drafting a document for [the deal](record:r1) for you to confirm.\",\"citations\":[\"r1\"],\"suggestions\":[],\"title\":null}"
      }
    }
  ]
}
