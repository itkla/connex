{
  "id": "parallel_mixed_tier_refusal",
  "selector": "connex_script_parallel_mixed_tier_refusal",
  "capabilityClass": "scripted-native-parallel",
  "steps": [
    {
      "afterToolCalls": 0,
      "protocol": "native",
      "emit": {
        "kind": "tool_call",
        "toolName": "search_records",
        "arguments": "{\"query\":\"Harrowmere\",\"kinds\":[\"person\"]}"
      }
    },
    {
      "afterToolCalls": 1,
      "protocol": "native",
      "emit": {
        "kind": "tool_call",
        "toolName": "find_tools",
        "arguments": "{\"toolset\":\"write_activity\"}"
      }
    },
    {
      "afterToolCalls": 2,
      "protocol": "native",
      "emit": {
        "kind": "tool_calls",
        "calls": [
          {
            "toolName": "get_record",
            "arguments": "{\"handle\":\"r1\"}"
          },
          {
            "toolName": "create_task",
            "arguments": "{\"handle\":\"r1\",\"description\":\"Confirm the renewal paperwork\"}"
          }
        ]
      }
    },
    {
      "afterToolCalls": 4,
      "protocol": "native",
      "emit": {
        "kind": "tool_call",
        "toolName": "create_task",
        "arguments": "{\"handle\":\"r1\",\"description\":\"Confirm the renewal paperwork\"}"
      }
    },
    {
      "afterToolCalls": 5,
      "protocol": "native",
      "emit": {
        "kind": "final",
        "text": "{\"text\":\"I added the follow-up task on [the contact](record:r1).\",\"citations\":[\"r1\"],\"suggestions\":[],\"title\":null}"
      }
    }
  ]
}
