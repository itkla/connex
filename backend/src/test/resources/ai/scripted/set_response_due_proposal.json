{
  "id": "set_response_due_proposal",
  "selector": "connex_script_set_response_due_proposal",
  "capabilityClass": "scripted-native",
  "steps": [
    {
      "afterToolCalls": 0,
      "protocol": "native",
      "emit": {
        "kind": "tool_call",
        "toolName": "search_records",
        "arguments": "{\"query\":\"Okonkwo\",\"kinds\":[\"person\"]}"
      }
    },
    {
      "afterToolCalls": 1,
      "protocol": "native",
      "emit": {
        "kind": "tool_call",
        "toolName": "find_tools",
        "arguments": "{\"toolset\":\"write_followup\"}"
      }
    },
    {
      "afterToolCalls": 2,
      "protocol": "native",
      "emit": {
        "kind": "tool_call",
        "toolName": "set_response_due",
        "arguments": "{\"handle\":\"r1\",\"due_in_hours\":48}"
      }
    },
    {
      "afterToolCalls": 3,
      "protocol": "native",
      "emit": {
        "kind": "final",
        "text": "{\"text\":\"I proposed a two-day first-response deadline for [the contact](record:r1) for you to confirm.\",\"citations\":[\"r1\"],\"suggestions\":[],\"title\":null}"
      }
    }
  ]
}
