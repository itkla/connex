{
  "id": "create_company_proposal",
  "selector": "connex_script_create_company_proposal",
  "capabilityClass": "scripted-native",
  "steps": [
    {
      "afterToolCalls": 0,
      "protocol": "native",
      "emit": {
        "kind": "tool_call",
        "toolName": "find_tools",
        "arguments": "{\"toolset\":\"write_create\"}"
      }
    },
    {
      "afterToolCalls": 1,
      "protocol": "native",
      "emit": {
        "kind": "tool_call",
        "toolName": "create_company",
        "arguments": "{\"name\":\"Cresthaven Labs\",\"website\":\"cresthaven.example\",\"industry\":\"Research\"}"
      }
    },
    {
      "afterToolCalls": 2,
      "protocol": "native",
      "emit": {
        "kind": "final",
        "text": "{\"text\":\"I checked the company request.\",\"citations\":[],\"suggestions\":[],\"title\":null}"
      }
    }
  ]
}
